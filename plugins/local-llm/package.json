{
  "name": "dsh-plugin-local-llm",
  "version": "0.3.0",
  "private": true,
  "description": "DeepSeek Harness plugin (dsh-plugins monorepo edition): local inference engines as first-class provider routes - LM Studio, Ollama, Lemonade, Strata, generic OpenAI-compatible - with Settings endpoint editing, model discovery, catalog enrichment, and the local_models tool.",
  "type": "module",
  "license": "MIT",
  "author": "umerkhalid204",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "dsh",
    "cordis",
    "llm",
    "local-models",
    "ollama",
    "lm-studio",
    "strata",
    "lemonade",
    "llama.cpp",
    "vllm",
    "openai-compatible",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "vendor/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}