{
  "name": "dsh-plugin-fleet",
  "version": "0.1.15",
  "private": true,
  "description": "DeepSeek Harness plugin: run several concurrent DSH hosts (each with its own DSH home, port and default LLM provider), and fan a task out across every LLM engine on the LAN — including machines that do not run DSH.",
  "type": "module",
  "license": "MIT",
  "author": "umerkhalid204",
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "dsh",
    "cordis",
    "profile",
    "instances",
    "multi-instance",
    "llm-provider",
    "fleet",
    "orchestration",
    "parallel"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./orchestrate": "./orchestrate.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "orchestrate.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
